# Discord Activity proxy (production build) — fetch uses /api via Discord proxy.
VITE_API_PROXY_PREFIX=/api
VITE_API_PROXY_TARGET=api.ambercoffer.belinde.click

# Public Activity URL (OAuth redirect fallback when not in iframe).
VITE_DISCORD_REDIRECT_URI=https://table.ambercoffer.belinde.click

# Standalone Vite dev without Discord proxy (optional):
# VITE_API_DIRECT_BASE_URL=https://api.ambercoffer.belinde.click

# Dev environment example:
# VITE_API_PROXY_TARGET=api-dev.ambercoffer.belinde.click
# VITE_DISCORD_REDIRECT_URI=https://table-dev.ambercoffer.belinde.click
