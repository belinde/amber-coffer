{
  "extends": "../../packages/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "aws-iot-device-sdk-v2": ["./node_modules/aws-iot-device-sdk-v2/dist/browser"],
      "aws-iot-device-sdk-v2/*": ["./node_modules/aws-iot-device-sdk-v2/dist/*"]
