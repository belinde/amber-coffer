{
  "name": "@amber/discord-bot",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "amber-discord-bot": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js",
    "generate:announcements": "node scripts/generate-announcements.mjs",
    "lint": "pnpm -w exec eslint apps/discord-bot/src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amber/shared": "workspace:*",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.18.0",
    "ffmpeg-static": "^5.2.0",
    "prism-media": "^1.3.5",
    "sodium-native": "^4.3.3"
  },
  "devDependencies": {
    "@amber/tsconfig": "workspace:*",
    "@types/node": "^22.13.4",
    "fast-check": "^4.8.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
