{
  "name": "@amber/build-public-canon",
  "version": "0.0.0",
  "private": true,
  "description": "Static site generator for public canon pages using @amber/ui and react-dom/server",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @amber/ui build",
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm -w exec eslint --max-warnings=0 tools/build-public-canon/src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "bin": {
    "amber-build-public-canon": "./dist/cli.js"
  },
  "dependencies": {
    "@amber/ui": "workspace:*",
    "zod": "^3.24.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@amber/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
